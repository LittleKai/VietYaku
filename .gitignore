# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.env
.flutter-plugins
.packages
data/*
!data/cn/
data/cn/*
!data/cn/LuatNhan.txt

# CodeGraph files
.codegraph/*
!.codegraph/.gitignore

# Generated repair files
**/*_JP.txt
.claude\tmp

# Temporary files (keep UI screenshots)
/tmp/*
!/tmp/ui-qa/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
